# Firebase (Spark plan) — copy to .env and fill from Firebase Console → Project settings → Your apps
# Web app config is enough to start; iOS/Android OAuth need extra console steps (see .agents/firebase-setup.md)

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional — only if you add Google sign-in on web/native later
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
