{
  "name": "orthodox-liturgical-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node scripts/prepare-gh-pages-spa.mjs",
    "deploy:gh-pages": "bash scripts/publish-gh-pages.sh",
    "lint": "expo lint",
    "generate:brand-assets": "node scripts/generate-brand-assets.mjs",
    "verify:liturgical-colors": "npx tsx scripts/verify-liturgical-colors.ts",
    "verify:fuzzy-search": "npx tsx scripts/verify-fuzzy-search.ts",
    "export:recipes": "npx tsx scripts/export-recipes-json.ts",
    "export:liturgy": "npx tsx scripts/build-chrysostom-liturgy.ts && npx tsx scripts/build-basil-liturgy.ts",
    "verify:fasting": "npx tsx scripts/verify-fasting-exceptions.ts",
    "verify:tone": "npx tsx scripts/verify-orthocal-tone.ts",
    "verify:content": "tsx scripts/verify-remote-content.ts",
    "verify:share": "tsx scripts/verify-recipe-share-link.ts",
    "verify:major-feast": "tsx scripts/verify-major-feast-day.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run verify:content && npm run verify:share && npm run verify:major-feast && npm run verify:liturgical-colors && npm run verify:fasting && npm run verify:tone",
    "build:ios": "eas build --platform ios --profile preview",
    "build:ios:production": "eas build --platform ios --profile production",
    "build:ios:local": "expo run:ios --device"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/material-top-tabs": "^7.6.17",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.25",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-iap": "^5.8.1",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "decode-uri-component": "file:./vendor/decode-uri-component",
    "uuid": "^11.1.1"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-iap"
        ]
      }
    }
  }
}
